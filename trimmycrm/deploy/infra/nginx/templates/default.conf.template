map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

map $http_x_forwarded_proto $forwarded_proto {
    ~*^https$ https;
    default http;
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=20r/m;
limit_req_zone $binary_remote_addr zone=booking_limit:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=public_read_limit:10m rate=120r/s;
limit_conn_zone $binary_remote_addr zone=per_ip:10m;

resolver 127.0.0.11 valid=10s ipv6=off;

upstream trimmycrm_api {
    zone trimmycrm_api 64k;
    server api:8000 resolve;
    keepalive 32;
}

upstream trimmycrm_frontend {
    zone trimmycrm_frontend 64k;
    server frontend:3000 resolve;
    keepalive 16;
}

server {
    listen 8080 default_server;
    server_name _;

    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    set $mailpit_ui_enabled ${MAILPIT_UI_ENABLED};
    set $ops_ui_enabled ${OPS_UI_ENABLED};
    set $api_docs_enabled ${API_DOCS_ENABLED};

    client_max_body_size 2m;
    client_body_timeout 15s;
    send_timeout 30s;
    limit_req_status 429;
    limit_conn_status 429;
    error_page 429 = @rate_limited;
    proxy_hide_header Server;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    # У пользовательских доменов могут быть посторонние поддомены; не задавайте includeSubDomains.
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Это пространство имён доступно только напрямую из пограничного контейнера в API.
    location = /api/v1/internal {
        return 404;
    }

    location ^~ /api/v1/internal/ {
        return 404;
    }

    location = /metrics {
        return 404;
    }

    location ~ ^/(?:verify-email|reset-password)$ {
        limit_req zone=auth_limit burst=10 nodelay;
        limit_conn per_ip 10;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location ~ ^/(?:docs|redoc|openapi\.json|api/(?:docs|redoc|openapi\.json))$ {
        if ($api_docs_enabled != "true") { return 404; }
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com" always;
    }

    location ~ ^/api/v1/(auth|t/auth)/(register|login|refresh|forgot-password|reset-password|verify-email|resend-verification) {
        limit_req zone=auth_limit burst=10 nodelay;
        limit_conn per_ip 10;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/api_security_headers.conf;
        add_header Cache-Control "no-store" always;
    }

    location ~ ^/api/v1/booking(?:/|$) {
        limit_req zone=booking_limit burst=20 nodelay;
        limit_conn per_ip 20;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/api_security_headers.conf;
    }

    # Публичные витрины читаются каждым посетителем сразу несколькими запросами.
    # Отдельный лимит защищает API от сканирования, не наказывая общий NAT салона
    # или мобильного оператора за нормальную параллельную загрузку страницы.
    location ~ ^/api/v1/(?:plans|public/(?:site|services|staff|reviews|promotions|media))(?:/|$) {
        limit_req zone=public_read_limit burst=240 nodelay;
        limit_conn per_ip 50;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/api_security_headers.conf;
    }

    location ~ ^/api/v1/media(?:/|$) {
        client_max_body_size 12m;
        limit_req zone=api_limit burst=60 nodelay;
        limit_conn per_ip 20;
        proxy_request_buffering off;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        include /etc/nginx/snippets/api_security_headers.conf;
        add_header Cache-Control "no-store" always;
    }

    # Browser refresh/logout are same-origin Next.js proxy handlers. They keep the
    # refresh cookie out of JavaScript while forwarding the request to the API.
    location ^~ /api/v1/frontend-auth/ {
        limit_req zone=auth_limit burst=10 nodelay;
        limit_conn per_ip 10;
        proxy_pass http://trimmycrm_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        limit_req zone=api_limit burst=60 nodelay;
        limit_conn per_ip 30;
        proxy_pass http://trimmycrm_api;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # Перезаписываем служебные заголовки арендатора. Серверная часть определяет его по этому хосту.
        proxy_set_header X-Tenant $host;
        proxy_set_header X-Tenant-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/api_security_headers.conf;
    }

    location @rate_limited {
        default_type application/json;
        include /etc/nginx/snippets/api_security_headers.conf;
        add_header Cache-Control "no-store" always;
        add_header Retry-After "1" always;
        return 429 '{"error":{"code":"rate_limited","message":"Too many requests. Please retry shortly."}}';
    }

    location ^~ /_dev/mail/ {
        if ($mailpit_ui_enabled != "true") { return 404; }
        set $mailpit_upstream http://mailpit:8025;
        proxy_pass $mailpit_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Prefix /_dev/mail;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location ^~ /_ops/grafana/ {
        if ($ops_ui_enabled != "true") { return 404; }
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location / {
        proxy_pass http://trimmycrm_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
